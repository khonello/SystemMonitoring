# Sources are edited on Windows but the Engine runs under WSL/Linux. Normalise
# to LF in the repository so the two never disagree about line endings.
* text=auto eol=lf

# Windows-only entry points keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touched.
*.png binary
*.jpg binary
*.ico binary
*.db binary
